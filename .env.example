# .env.example - Copy this to .env and fill in your values

# Site Domain (update after domain registration)
PUBLIC_SITE_DOMAIN=https://your-domain.com

# Amazon Affiliate Tags by Region
# Update these after Amazon Associates approval for each marketplace
PUBLIC_AMAZON_TAG_UK=YOUR_TAG-21
PUBLIC_AMAZON_TAG_DE=hardwarelab-03
PUBLIC_AMAZON_TAG_FR=hardwarelab-21
PUBLIC_AMAZON_TAG_IT=YOUR_TAG-21
PUBLIC_AMAZON_TAG_ES=YOUR_TAG-21
# Optional legacy fallback (not primary for current setup)
PUBLIC_AMAZON_TAG_US=YOUR_TAG-20

# Google Analytics 4 Measurement ID
PUBLIC_GA_ID=G-XXXXXXXXXX

# Enable/disable analytics (set to false for local development)
PUBLIC_ANALYTICS_ENABLED=true

# Cloudflare Turnstile (optional, but recommended in production)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Set to true in production (fail-closed if captcha validation is unavailable)
TURNSTILE_ENFORCE=false

# Runtime webhook config (server-side only, not exposed to client)
# Use one of:
# - Docker internal URL (recommended on VPS): http://n8n:5678/webhook/hardwarelab-forms
# - Public URL (if needed): https://n8n.your-domain.com/webhook/hardwarelab-forms
N8N_WEBHOOK_URL=http://n8n:5678/webhook/hardwarelab-forms
# Comma-separated allowlist of webhook hostnames (hostname only, no scheme/port)
N8N_WEBHOOK_ALLOWED_HOSTS=n8n,n8n.hardwarelab.org,localhost,127.0.0.1
# 32-byte random secret in hex (64 chars), e.g. `openssl rand -hex 32`
N8N_WEBHOOK_SECRET=replace-with-64-char-hex-secret
N8N_WEBHOOK_SECRET_FALLBACK=

# Comma-separated allowlist for Origin/Referer checks in /api/contact
ALLOWED_ORIGINS=https://hardwarelab.org,https://www.hardwarelab.org,http://localhost:4321,http://localhost:8081
