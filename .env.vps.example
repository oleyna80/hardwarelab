# Production config
HOST=0.0.0.0
PORT=4321
APP_PORT=8081

# Docker image repository (GHCR)
IMAGE_REPO=ghcr.io/oleyna80/hardwarelab
IMAGE_TAG=sha-REPLACE_WITH_COMMIT_SHA

# Runtime webhook config for Astro API endpoint
# Use internal docker DNS to keep n8n private.
N8N_WEBHOOK_URL=http://n8n:5678/webhook/hardwarelab-forms
N8N_WEBHOOK_ALLOWED_HOSTS=n8n,n8n.hardwarelab.org,localhost,127.0.0.1
N8N_WEBHOOK_SECRET=replace-with-strong-secret
N8N_WEBHOOK_SECRET_FALLBACK=

# Cloudflare Turnstile (enable in production)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ENFORCE=true
ALLOWED_ORIGINS=https://hardwarelab.org,https://www.hardwarelab.org
