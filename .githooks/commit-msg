#!/usr/bin/env bash
set -euo pipefail

message_file="$1"
subject=$(sed -n '1p' "$message_file")

case "$subject" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

if [[ "$subject" =~ ^(feat|fix|docs|chore|refactor|test|ci|build|perf|style|revert)(\([a-z0-9._/-]+\))?(!)?:\ .{3,}$ ]]; then
  exit 0
fi

echo 'Commit subject must be e.g. "docs: add project map" or "fix(api): handle timeout".' >&2
exit 1
