---
import CategoryDetailPage from "@/components/categories/CategoryDetailPage.astro";
import { categoryCatalog, categorySlugs } from "@/data/categoryCatalog";

export const prerender = true;

export async function getStaticPaths() {
    return categorySlugs.map((category) => ({
        params: { category },
    }));
}

const category = categoryCatalog[Astro.params.category as keyof typeof categoryCatalog];
---

<CategoryDetailPage category={category} lang="en" />
