---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import ReviewCard from "@/components/ui/ReviewCard.astro";
import { t, type Language } from "@/utils/i18n";

const lang: Language = "fr";

const allReviews = await getCollection("reviews", ({ data }) => import.meta.env.DEV ? true : !data.draft);
const reviews = allReviews
    .filter((review) => review.id.startsWith("fr/"))
    .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

const byCategory = (cat: string) => reviews.filter((r) => r.data.category === cat);

const categoryList = [
    { slug: "mini-pc", label: "Mini-PCs", icon: "🖥️" },
    { slug: "consoles", label: "Consoles", icon: "🎮" },
    { slug: "monitors", label: "Moniteurs", icon: "📺" },
    { slug: "nas", label: "NAS", icon: "🗄️" },
    { slug: "sbc", label: "SBC", icon: "🛠️" },
    { slug: "ai-workstation", label: "Stations IA", icon: "🤖" },
];

const pageTitle = "Tous les avis matériel | HardwareLab";
const pageDescription = "Parcourez tous nos avis matériel approfondis. Analyses d'experts sur les Mini-PCs, consoles, moniteurs, NAS, SBCs et stations IA.";
---

<Layout title={pageTitle} description={pageDescription} lang={lang}>
    <div class="fade-in">
        <section class="text-center py-16">
            <h1 class="text-4xl md:text-6xl font-bold mb-6">
                Tous les avis
            </h1>
            <p class="text-xl text-primary-600 dark:text-primary-400 max-w-3xl mx-auto mb-8">
                Avis experts et approfondis sur le dernier matériel informatique. Analyses honnêtes pour des décisions d'achat éclairées.
            </p>
            <div class="flex items-center justify-center gap-2 text-sm text-primary-500 dark:text-primary-400">
                <a href="/fr/" class="hover:text-accent-600 transition-colors">Accueil</a>
                <span>›</span>
                <span class="text-primary-700 dark:text-primary-300">Tous les avis</span>
            </div>
        </section>

        <section class="py-6 mb-8">
            <div class="flex flex-wrap items-center justify-center gap-6 text-center">
                <div class="flex items-center gap-2">
                    <span class="text-3xl font-bold text-accent-600 dark:text-accent-400">{reviews.length}</span>
                    <span class="text-primary-600 dark:text-primary-400">Avis</span>
                </div>
                <div class="hidden md:block w-px h-8 bg-primary-300 dark:bg-primary-700"></div>
                <div class="flex items-center gap-2">
                    <span class="text-3xl font-bold text-accent-600 dark:text-accent-400">{categoryList.length}</span>
                    <span class="text-primary-600 dark:text-primary-400">Catégories</span>
                </div>
                <div class="hidden md:block w-px h-8 bg-primary-300 dark:bg-primary-700"></div>
                <div class="flex items-center gap-2">
                    <span class="text-3xl font-bold text-accent-600 dark:text-accent-400">100%</span>
                    <span class="text-primary-600 dark:text-primary-400">Honnête</span>
                </div>
            </div>
        </section>

        <section class="mb-12">
            <h2 class="text-2xl font-bold mb-6 text-center">Parcourir par catégorie</h2>
            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
                {categoryList.map((cat) => (
                    <a
                        href={`/fr/categories/${cat.slug}`}
                        class="group p-4 bg-primary-100 dark:bg-primary-900 rounded-xl hover:bg-accent-500 dark:hover:bg-accent-600 transition-colors text-center"
                    >
                        <div class="text-3xl mb-2 group-hover:text-white">{cat.icon}</div>
                        <h3 class="font-bold text-sm group-hover:text-white mb-1">{cat.label}</h3>
                        <p class="text-xs text-primary-600 dark:text-primary-400 group-hover:text-white/80">
                            {byCategory(cat.slug).length} avis
                        </p>
                    </a>
                ))}
            </div>
        </section>

        <section class="py-8">
            <div class="flex items-center justify-between mb-8">
                <h2 class="text-3xl font-bold">{t("latestReviews", lang)}</h2>
                <div class="text-sm text-primary-600 dark:text-primary-400">Trié par date</div>
            </div>
            {reviews.length > 0 ? (
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    {reviews.map((review) => <ReviewCard review={review} lang={lang} />)}
                </div>
            ) : (
                <div class="text-center py-16">
                    <div class="text-6xl mb-4">📝</div>
                    <h2 class="text-2xl font-bold mb-4">Pas encore d'avis</h2>
                    <p class="text-primary-600 dark:text-primary-400">{t("noReviews", lang)}</p>
                </div>
            )}
        </section>

        <section class="py-16 mt-12 text-center bg-gradient-to-r from-primary-100 to-accent-100 dark:from-primary-900 dark:to-accent-900/30 rounded-3xl">
            <h2 class="text-3xl font-bold mb-4">{t("stayUpdated", lang)}</h2>
            <p class="text-xl text-primary-600 dark:text-primary-400 max-w-2xl mx-auto mb-8">
                {t("newsletterDescription", lang)}
            </p>
            <form class="max-w-md mx-auto flex gap-2">
                <input
                    type="email"
                    placeholder={t("emailPlaceholder", lang)}
                    class="flex-grow px-4 py-3 rounded-lg border border-primary-300 dark:border-primary-700 bg-white dark:bg-primary-800 focus:outline-none focus:ring-2 focus:ring-accent-500"
                    required
                />
                <button type="submit" class="px-6 py-3 bg-accent-600 text-white font-semibold rounded-lg hover:bg-accent-700 transition-colors whitespace-nowrap">
                    {t("subscribe", lang)}
                </button>
            </form>
            <p class="text-sm text-primary-500 dark:text-primary-400 mt-4">{t("noSpam", lang)}</p>
        </section>
    </div>
</Layout>
